# Stricter SPX data quality (copy to .env or export before running)
export GEX_DATA_FILTERS=1
export GEX_MIN_OPEN_INTEREST=10
export GEX_MAX_STRIKE_DISTANCE_PCT=0.25
export GEX_MAX_BID_ASK_SPREAD_PCT=0.5

# Unusual Whales (primary data source)
export UW_API_KEY=your-key-here

# Scheduled refresh
export GEX_DEFAULT_TICKERS=SPX
export GEX_REFRESH_INTERVAL_MINUTES=10
