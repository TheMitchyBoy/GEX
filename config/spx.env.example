# Unusual Whales (required — only data source)
export UW_API_KEY=your-key-here

# Scheduled refresh
export GEX_DEFAULT_TICKERS=SPX
export GEX_REFRESH_INTERVAL_MINUTES=10
export GEX_BACKFILL_INTERVAL_MINUTES=10
export GEX_INTRADAY_BACKFILL_DAYS=90
export GEX_DAILY_BACKFILL_DAYS=90
export GEX_DASHBOARD_TIMELINE_DAYS=90
export GEX_DASHBOARD_HISTORY_DAYS=30
export GEX_DASHBOARD_HISTORY_MAX=120

# Alerts (optional)
# export GEX_ALERT_WEBHOOK_URL=https://example.com/hook
# export GEX_ALERT_AUTO_DISPATCH=1
# export GEX_ALERT_WALL_SHIFT_PTS=20

# Live flow overlay (optional)
