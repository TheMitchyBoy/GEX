# Unusual Whales (required — only data source)
export UW_API_KEY=your-key-here

# Periscope session dates/times (export keys stay UTC; UI uses market timezone)
# export GEX_MARKET_TIMEZONE=America/New_York
# export GEX_MARKET_TIMEZONE_LABEL=ET

# Persistent data (exports, SQLite journals). On Railway, mount a volume at /app/data.
# export GEX_DATA_DIR=/app/data

# Scheduled refresh
export GEX_DEFAULT_TICKERS=SPX
export GEX_REFRESH_INTERVAL_MINUTES=2
export GEX_BACKFILL_INTERVAL_MINUTES=2
export GEX_INTRADAY_BACKFILL_DAYS=90
export GEX_DAILY_BACKFILL_DAYS=90
export GEX_DASHBOARD_TIMELINE_DAYS=90
export GEX_DASHBOARD_HISTORY_DAYS=90
export GEX_DASHBOARD_HISTORY_MAX=240
export GEX_PREDICTION_LOOKBACK_DAYS=90
export GEX_PREDICTION_LOOKBACK_FALLBACK_DAYS=90
export GEX_BACKTEST_MAX_FOLDS=24
export GEX_BACKTEST_LOOKBACK_DAYS=30
export GEX_BACKTEST_MAX_SNAPSHOTS=80
# Skip walk-forward backtest during HTML page render (default on for Railway responsiveness)
export GEX_DASHBOARD_SKIP_BACKTEST=1
# Throttle SQLite index reconciliation (seconds between full disk scans per ticker)
export GEX_INDEX_SYNC_TTL_SEC=120
# Cap in-memory UW intraday day caches (ticker, date) pairs
export GEX_PERISCOPE_DAY_CACHE_MAX=8
# AI daily learning — lessons from prior sessions + today's strategy plan
export GEX_AI_LESSON_LOOKBACK_DAYS=7
export GEX_AI_LESSON_BACKFILL_DAYS=5
export GEX_AI_STRATEGY_CACHE_SEC=7200
# Chat persistence + LLM prediction calibration
export GEX_CHAT_PERSIST_DAYS=14
export GEX_LLM_CALIB_MIN_SAMPLES=5
# UW live price feed (websocket price:TICKER + OHLC REST for chart history)
export GEX_UW_PRICE_WS=1
export GEX_UW_OHLC_CANDLE_SIZE=15m
export GEX_UW_OHLC_LIMIT=800
export GEX_UW_PRICE_WS_MAX_POINTS=2500
export GEX_PREDICTION_HISTORY_MAX=240
# Keep duplicate strike profiles for KNN (0 = off, default; set 1 to dedupe like dashboard)
# export GEX_PREDICTION_DEDUP=1
# Model training: 0 = all strike CSVs on disk (3000+ intraday snapshots)
export GEX_TRAIN_LOOKBACK_DAYS=0
# export GEX_TRAIN_DEDUPE_IDENTICAL_STRIKES=1
# Retrain on deploy only when manifest is stale vs disk (not every boot)
# export GEX_RETRAIN_ON_START=1
export GEX_DEFERRED_STARTUP_SEC=3
export GEX_HEALTH_CACHE_SEC=30
# Wall GEX page: avoid blocking HTML on UW API (status API uses timeout + cache)
# export GEX_UW_FETCH_TIMEOUT_SEC=12
# export GEX_WALL_GEX_LIVE_CACHE_SEC=15
# Set on Railway/first deploy to pull 90-day history and retrain once at startup
# export GEX_STARTUP_BACKFILL=1
# Auto backfill when fewer than 4 strike CSVs exist (default on; disable after first fill)
# export GEX_AUTO_BACKFILL_IF_EMPTY=0

# Hermes Agent (optional — bash scripts/install_agent.sh)
# export OPENAI_API_KEY=your-key-here
# export OPENROUTER_API_KEY=your-key-here
# export GEX_HERMES_PROVIDER=openai
# export GEX_AGENT_MODEL=gpt-4o

# AI context bundle (full Unusual Whales data fed to LLM predictions)
# export GEX_AI_CONTEXT_MAX_STRIKES=64
# export GEX_AI_INTRADAY_TAIL=45
# export GEX_AI_HISTORY_TAIL=30
# export GEX_AI_MAX_TOKENS=1200
# export GEX_AI_TEMPERATURE=0.35
# export GEX_ADVISOR_CONTEXT_MAX_CHARS=24000

# Admin token for state-changing HTTP actions (refresh, bootstrap, alert dispatch).
# Required for POST /ticker/SPX/refresh and /ticker/SPX/dispatch-alerts when set.
# export GEX_ADMIN_TOKEN=change-me

# Flask dev server only (gunicorn ignores this)
# export FLASK_DEBUG=0

# Alerts (optional)
# export GEX_ALERT_WEBHOOK_URL=https://example.com/hook
# export GEX_ALERT_AUTO_DISPATCH=1
# export GEX_ALERT_WALL_SHIFT_PTS=20

# Live flow overlay (optional)
# export GEX_FLOW_FEED=data/live_flow.jsonl

# Gamma auto-trader — SPX gamma signals, SPY option execution (default)
# export GEX_AUTO_TRADER=1
# export GEX_SIGNAL_TICKER=SPX
# export GEX_EXECUTION_TICKER=SPY
# export GEX_TRADER_PAPER=0
# export GEX_TRADER_LIVE_CONFIRM=1
# export GEX_WEBULL_APP_KEY=your-app-key
# export GEX_WEBULL_APP_SECRET=your-app-secret
# export GEX_WEBULL_ACCOUNT_ID=your-account-id
# Production OpenAPI uses app-key auth only (no SMS verification required).
# export GEX_WEBULL_ENDPOINT=api.webull.com
# export GEX_WEBULL_DATA_ENDPOINT=broker-api.webull.com
# export GEX_WEBULL_USE_UAT=1
# UAT: us-openapi-alb.uat.webullbroker.com / us-broker-api.uat.webullbroker.com
# export GEX_WEBULL_UNDERLYING=SPY
# Webull OAuth token file (auto-defaults to $GEX_DATA_DIR/webull/token.txt on boot)
# export WEBULL_OPENAPI_TOKEN_DIR=/app/data/webull
# Webull quick-trade desk: GET /trade (quote ladder + entry/exit conditions)
# Live orders require live_confirm in API body; set GEX_ADMIN_TOKEN for HTTP order auth
# export GEX_WEBULL_FILL_TIMEOUT_SEC=45
# export GEX_WEBULL_FILL_POLL_SEC=2
# Option quote / position cache (reduces 429 rate limits on the trade desk)
# export GEX_WEBULL_QUOTE_CACHE_SEC=3
# export GEX_WEBULL_POSITION_CACHE_SEC=30
# export GEX_TRADER_CYCLE_SECONDS=15
# export GEX_TRADER_BAR_MINUTES=2
# export GEX_TRADER_SESSION_ONLY=1
# export GEX_TRADER_CONTRACTS=1
# export GEX_TRADER_STOP_LOSS_PCT=0.06
# export GEX_TRADER_TAKE_PROFIT_PCT=0.28
# export GEX_TRADER_TIME_STOP_BARS=7
# Wall GEX trader (low/high gamma strike strategy)
# export GEX_WALL_STOP_LOSS_PCT=0.03
# export GEX_WALL_TAKE_PROFIT_PCT=0.22
# export GEX_WALL_REENTER_ON_SHIFT=1
# export GEX_WALL_REENTRY_AFTER_STOP=1
# export GEX_WALL_INTRADAY_SESSION=1
# export GEX_WALL_ENTRY_TIME_FILTER=1
export GEX_WALL_MAX_HOLD_BARS=8
export GEX_WALL_SIGNAL_FILTERS=0
export GEX_WALL_GEX_AUTO=1
export GEX_WALL_GEX_CYCLE_SECONDS=30
# Dashboard page load: only fetch the current gamma slice (exports/backfill still save full history)
export GEX_PAGE_MINIMAL_LOAD=1
# Near-spot wall GEX (/near, ±1% strike window) — MC-tuned on 14d backtest
# export GEX_NEAR_WALL_WINDOW_PCT=0.01
# export GEX_NEAR_WALL_STOP_LOSS_PCT=0.03
# export GEX_NEAR_WALL_TAKE_PROFIT_PCT=0.28
# export GEX_NEAR_WALL_MAX_HOLD_BARS=10
# export GEX_NEAR_WALL_REENTER_ON_SHIFT=0
# export GEX_NEAR_WALL_SHIFT_MIN_PTS=0.5
# export GEX_AUTO_TRADER=0
# Optional (enable to filter weak walls / regime / drift):
# export GEX_WALL_SIGNAL_FILTERS=1
# export GEX_WALL_MIN_GAMMA_BN=0.3
# export GEX_WALL_BLOCK_SHORT_GAMMA=0
# export GEX_WALL_MIN_DRIFT_PTS=0
# export GEX_LOW_GEX_REENTER_EACH_BAR=0
# export GEX_TRADER_MAX_HOLD_MINUTES=30
# export GEX_TRADER_MAX_OPEN=2
# export GEX_TRADER_MULTI_STRIKE=2
# export GEX_TRADER_MAX_ENTRIES_PER_CYCLE=1
# export GEX_TRADER_TIME_STOP_BARS=10
# export GEX_TRADER_TIME_STOP_MIN_PNL_PCT=0
# export GEX_TRADER_TIME_STOP_MIN_PROGRESS=0.35
# export GEX_TRADER_MAGNET_TOUCH_MIN_PNL_PCT=0.04
# export GEX_TRADER_PARTIAL_TP_PCT=0.08
# export GEX_TRADER_STOP_COOLDOWN_BARS=2
# export GEX_TRADING_DB=data/trading_journal.db
# Account sizing & enhanced filters (defaults tuned for ~$500 SPY 0DTE)
# export GEX_TRADER_ACCOUNT_EQUITY=500
# export GEX_TRADER_RISK_SIZING=1
# export GEX_TRADER_RISK_PER_TRADE_PCT=0.50
# Live Webull: use broker net liquidation for risk % (default on when live)
# export GEX_TRADER_USE_WEBULL_EQUITY=1
# export GEX_WEBULL_EQUITY_CACHE_SEC=60
# export GEX_TRADER_EOD_FLATTEN=0
# export GEX_TRADER_EOD_FLATTEN_HOUR=15
# export GEX_TRADER_EOD_FLATTEN_MIN=45
# export GEX_TRADER_MAX_STRIKE_DISTANCE_PCT=0.02
# export GEX_TRADER_ENTRY_TIME_FILTER=0
# export GEX_TRADER_ENTRY_AFTER_OPEN_MIN=15
# export GEX_TRADER_ENTRY_BEFORE_CLOSE_MIN=30
# export GEX_TRADER_MIN_GAMMA_DELTA=0.02
# export GEX_TRADER_CLEAR_FILTERS=0
# export GEX_TRADER_MIN_ENTRY_CONFIDENCE=0
# export GEX_TRADER_STRICT_FILTERS=0
# Dominant +γ magnet by default; set 1 to also trade lowest −γ walls
# export GEX_TRADER_MAX_GAMMA_ONLY=1
# export GEX_TRADER_TRADE_NEGATIVE_GAMMA=0
# Trade at the gamma magnet strike instead of nearest ATM (A/B via backtest)
# export GEX_TRADER_MAGNET_ANCHORED_STRIKES=0
# export GEX_TRADER_FIX_MAGNET_EXIT_SCALE=1
# export GEX_TRADER_MAGNET_TOUCH_EXIT=0
# export GEX_TRADER_DYNAMIC_TP=0
# export GEX_TRADER_DYNAMIC_TIME_STOP=0
# export GEX_TRADER_REQUIRE_MOMENTUM=0
# export GEX_TRADER_REQUIRE_FLIP_SIDE=0
# Flow alignment filter (default off — 2-week backtest: +$79 PnL vs strict flow gate)
# export GEX_TRADER_REQUIRE_FLOW_ALIGN=1
# export GEX_TRADER_MIN_FLOW_BUY_RATIO=0.55
