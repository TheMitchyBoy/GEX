# Unusual Whales (required — only data source)
export UW_API_KEY=your-key-here

# Scheduled refresh
export GEX_DEFAULT_TICKERS=SPX
export GEX_REFRESH_INTERVAL_MINUTES=10
export GEX_BACKFILL_INTERVAL_MINUTES=10
export GEX_INTRADAY_BACKFILL_DAYS=90
export GEX_DAILY_BACKFILL_DAYS=90
export GEX_DASHBOARD_TIMELINE_DAYS=90
export GEX_DASHBOARD_HISTORY_DAYS=90
export GEX_DASHBOARD_HISTORY_MAX=240
export GEX_PREDICTION_LOOKBACK_DAYS=90
export GEX_PREDICTION_LOOKBACK_FALLBACK_DAYS=90
export GEX_BACKTEST_MAX_FOLDS=24
export GEX_BACKTEST_LOOKBACK_DAYS=30
export GEX_BACKTEST_MAX_SNAPSHOTS=80
# Skip walk-forward backtest during HTML page render if the dashboard is timing out
# export GEX_DASHBOARD_SKIP_BACKTEST=1
# UW live price feed (websocket price:TICKER + OHLC REST for chart history)
export GEX_UW_PRICE_WS=1
export GEX_UW_OHLC_CANDLE_SIZE=15m
export GEX_UW_OHLC_LIMIT=800
export GEX_UW_PRICE_WS_MAX_POINTS=2500
export GEX_PREDICTION_HISTORY_MAX=240
# Keep duplicate strike profiles for KNN (0 = off, default; set 1 to dedupe like dashboard)
# export GEX_PREDICTION_DEDUP=1
# Model training: 0 = all strike CSVs on disk (3000+ intraday snapshots)
export GEX_TRAIN_LOOKBACK_DAYS=0
# export GEX_TRAIN_DEDUPE_IDENTICAL_STRIKES=1
# Retrain on every deploy (one-time after changing lookback to 0)
# export GEX_RETRAIN_ON_START=1
# Set on Railway/first deploy to pull 90-day history and retrain once at startup
# export GEX_STARTUP_BACKFILL=1
# Auto backfill when fewer than 4 strike CSVs exist (default on; disable after first fill)
# export GEX_AUTO_BACKFILL_IF_EMPTY=0

# Alerts (optional)
# export GEX_ALERT_WEBHOOK_URL=https://example.com/hook
# export GEX_ALERT_AUTO_DISPATCH=1
# export GEX_ALERT_WALL_SHIFT_PTS=20

# Live flow overlay (optional)
# export GEX_FLOW_FEED=data/live_flow.jsonl
